BACKEND_API_URL=https://api.spotea.internal/v1
NEXT_PUBLIC_APP_URL=http://localhost
REDIS_URL=redis://localhost:6379

# BFF token refresh tuning (optional, ada default di kode)
# REFRESH_FETCH_TIMEOUT_MS = (LOCK_TTL - 2) * 1000 — pastikan TTL >= 3 detik
# MAX_POLL_ITERATIONS = ceil((LOCK_TTL + 1) * 1000 / POLL_INTERVAL_MS)
BFF_REFRESH_LOCK_TTL_SECONDS=7
BFF_POLL_INTERVAL_MS=200
