{
  "$schema": "https://turborepo.dev/microfrontends/schema.json",
  "applications": {

    "spotea-consumer": {
      "development": {
        "local": {
          "port": 3000
        }
      }
    },

    "spotea-merchant": {
      "development": {
        "local": {
          "port": 3001
        }
      },
      "routing": [
        {
          "paths": ["/merchant", "/merchant/:path*"]
        }
      ]
    },

    "spotea-backoffice": {
      "development": {
        "local": {
          "port": 3002
        }
      },
      "routing": [
        {
          "paths": ["/backoffice", "/backoffice/:path*"]
        }
      ]
    }
  }
}