{
  "$schema": "https://turborepo.dev/microfrontends/schema.json",
  "applications": {
    "shell": {
      "development": {
        "local": {
          "port": 3000
        }
      }
    },

    "merchant": {
      "development": {
        "local": {
          "port": 3001
        }
      },
      "routing": [
        {
          "paths": ["/merchant", "/merchant/:path*"]
        }
      ]
    },

    "admin": {
      "development": {
        "local": {
          "port": 3002
        }
      },
      "routing": [
        {
          "paths": ["/admin", "/admin/:path*"]
        }
      ]
    },

    "consumer": {
      "development": {
        "local": {
          "port": 3003
        }
      },
      "routing": [
        {
          "paths": ["/consumer", "/consumer/:path*"]
        }
      ]
    },

    "account": {
      "development": {
        "local": {
          "port": 3004
        }
      },
      "routing": [
        {
          "paths": ["/account", "/account/:path*"]
        }
      ]
    }
  }
}
